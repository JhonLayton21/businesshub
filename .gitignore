cat << 'EOF' > .gitignore
# Environment variables & Secrets
.env
.env.*

# Build outputs
target/
build/

# IDEs & Editors
.idea/
*.iml
.vscode/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*
EOF